        <!-- ===== Gain_act (margin test) ===== -->
        <mxCell id="gain" value="Gain_act&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;×1 mặc định&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="270" width="80" height="40" as="geometry" />
