<mxfile host="app.diagrams.net">
  <diagram id="closed_loop" name="Closed loop">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Title ===== -->
        <mxCell id="title" value="&lt;b&gt;Kiến trúc vòng kín Adaptive C-EPS&lt;/b&gt; (trường hợp tổng quát: bộ điều khiển dùng đủ mọi tín hiệu đo; Model_&amp;lt;Ctrl&amp;gt;.mdl sinh bằng build_closed_loop)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Scenario inputs ===== -->
        <mxCell id="scen" value="Kịch bản: người lái và mặt đường (theta1, v, mu)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="1220" y="40" width="470" height="40" as="geometry" />
        </mxCell>

        <!-- ===== Measured-signal bus ===== -->
        <mxCell id="bus" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="150" y="160" width="6" height="320" as="geometry" />
        </mxCell>
        <mxCell id="busLabel" value="Bus tín hiệu đo" style="text;html=1;align=center;verticalAlign=middle;rotation=-90;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="120" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Controller ===== -->
        <mxCell id="ctrl" value="&lt;b&gt;Bộ điều khiển (Controller)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Map / PI / PID / SMC / ISMC&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="140" width="400" height="360" as="geometry" />
        </mxCell>
        <mxCell id="ref" value="Reference&lt;br&gt;T_d,ref(v, a_y)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="180" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sum" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="400" y="275" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sumPlus" value="+" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="290" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sumMinus" value="−" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="418" y="255" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="law" value="Luật điều khiển" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="260" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ctrlNote" value="Mỗi bộ chỉ khai báo cổng vào cần dùng (nối theo TÊN);&lt;br&gt;cổng không dùng nối Terminator. Ra duy nhất: T_a_cmd." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="210" y="455" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- ===== AssistLimit ===== -->
        <mxCell id="lim" value="AssistLimit&lt;br&gt;T_a,max(v)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="85" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Delay_ctrl (margin test) ===== -->
        <mxCell id="delay" value="Delay_ctrl&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;trễ, mặc định 0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="270" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- ===== Actuator ===== -->
