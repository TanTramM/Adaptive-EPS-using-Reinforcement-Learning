          <mxGeometry x="1190" y="680" width="520" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;Khối nét đứt Delay_ctrl, Gain_act: kiểm độ dư ổn định (QuyChuan 5.2), mặc định trễ 0 và ×1.&lt;br&gt;Khối Chấm điểm: chỉ để đánh giá, bộ điều khiển chỉ thấy tín hiệu đo.&lt;br&gt;mu không đo được (nhiễu loạn từ mặt đường)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="680" width="560" height="80" as="geometry" />
