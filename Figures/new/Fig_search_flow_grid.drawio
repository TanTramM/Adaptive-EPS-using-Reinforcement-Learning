<mxfile host="drawio"><diagram name="Page-1" id="fig"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;1. Biến thiết kế và hộp&lt;/b&gt;&lt;br&gt;Map 2 biến (K, g_min); PID 4 (Kp, Ki, Kd, Tf); MapPID: Map khóa, 4 biến PID" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="190" y="36" width="600" height="84" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;2. Đánh giá MỘT thiết kế trên CALIB v2&lt;/b&gt;&lt;br&gt;sàng lọc tuyến tính (PM, GM, độ lợi lag) → mô phỏng 140 s → R, S, TV, e_rel" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="190" y="158" width="600" height="84" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;3. QUÉT LƯỚI thô rồi mịn, seed tìm riêng của bộ&lt;/b&gt;&lt;br&gt;Map 00000, PID 10000, MapPID 30000; mỗi dòng ghi csv, chạy tiếp được" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="190" y="280" width="600" height="84" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;4. CỔNG và CHỌN trên mặt Pareto (R, S)&lt;/b&gt;&lt;br&gt;PM ≥ 30°, GM ≥ 2, lag ≥ 0.707, e_rel ≤ 10 %, calib_margin; J = R·S" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="190" y="402" width="600" height="84" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;5. TẬP DỰ TUYỂN CHUNG: mọi điểm qua cổng tuyến tính&lt;/b&gt;&lt;br&gt;Map 149, PID 168, MapPID 211 = 528 điểm (cùng một bộ lọc cho ba bộ)" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="190" y="524" width="600" height="84" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;6. ĐÁNH GIÁ LẠI trên 5 seed chung 99990–99994&lt;/b&gt;&lt;br&gt;pha 1: mặt ở seed tìm; pha 2: điểm trong dải nhiễu 3σ (cùng luật cho ba bộ)" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="190" y="646" width="600" height="84" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;7. MARGIN và HAI MẶT, so mặt Pareto theo R_tb, S_tb&lt;/b&gt;&lt;br&gt;calib_margin (seed 99990) cho điểm trên mặt; mặt an toàn, mặt đủ cổng" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="190" y="768" width="600" height="84" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;8. KIỂM điểm đã chọn trên DREWS v2 (chỉ báo cáo, không chọn)&lt;/b&gt;&lt;br&gt;DRY, RAMP, SLIP, EDGE, WEAVE; năm seed 99995–99999" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="190" y="890" width="600" height="84" as="geometry"/></mxCell>
