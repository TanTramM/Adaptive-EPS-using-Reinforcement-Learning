<mxfile host="drawio"><diagram name="Page-1" id="fig"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;1. Biến thiết kế và hộp tìm kiếm&lt;/b&gt;&lt;br&gt;x = (Kp, Ki, Kd, Tf) ↔ u, n biến, mỗi biến trong [0,1] (thang log)" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="150" y="40" width="600" height="80" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;2. Đánh giá MỘT thiết kế x trên CALIB v2 (seed s)&lt;/b&gt;&lt;br&gt;sàng lọc tuyến tính → mô phỏng 140 s → R, S, J = R·S, e_rel" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="150" y="166" width="600" height="80" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;3. TÌM toàn cục: surrogateopt, 3 chuỗi độc lập × 250 lần&lt;/b&gt;&lt;br&gt;seed tìm x0000; ràng buộc: PM, GM, dải lái, e_rel" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="150" y="292" width="600" height="80" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;4. NHÓM TOP: 20 thiết kế khả thi, khác nhau, J nhỏ nhất&lt;/b&gt;&lt;br&gt;gộp mọi lần đánh giá của ba chuỗi" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="150" y="418" width="600" height="80" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;5. CHỌN trên 5 seed x0001–x0005&lt;/b&gt;&lt;br&gt;J_tb = trung bình J, σ_J; cổng e_rel ở MỌI seed; hòa → PM lớn hơn" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="150" y="544" width="600" height="80" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;6. KIỂM và CHẤM&lt;/b&gt;&lt;br&gt;calib_margin; chấm DREWS trên 5 seed 99999–99995; so theo cặp" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.6;fontColor=#222222;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="150" y="670" width="600" height="80" as="geometry"/></mxCell>
